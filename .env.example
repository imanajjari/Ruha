# Required for production: use a long random secret; never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional PostgreSQL. If DB_NAME is blank SQLite is used.
DB_NAME=
DB_USER=ruha
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Web Push is optional until VAPID keys are configured.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUBJECT=mailto:admin@example.com
